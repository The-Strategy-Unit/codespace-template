{
  "name": "Python (uv)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/astral-sh/uv:latest": {}
  },

  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },

  "postCreateCommand": "uv sync",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },

  "forwardPorts": []
}